<!DOCTYPE html>
<html>

<%- include('partials/head.ejs') %>


    <body>
        <h1>Nutrients Query</h1>
        <%- include('partials/nav.ejs') %>
            <main>
                <h2>Lipids & Fatty Acids</h2>

                <% if (nutrients.length===0) { %>
                    <p>Lipids & Fatty Acids are not found with this food</p>
                    <% } else { %>
                        <ul>
                            <% nutrients.forEach(nutrient=> { %>
                                <li>
                                    <%= nutrient.nutrientName %>:
                                        <%= nutrient.value %>
                                            <%= nutrient.unitName %>
                                </li>
                                <% }) %>
                        </ul>
                        <% } %>
            </main>
            <%- include('partials/footer.ejs') %>

    </body>

</html>